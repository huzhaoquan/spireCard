[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/HandArea.tscn" id="1_hand_area_scene"]

[sub_resource type="GDScript" id="GDScript_card_test"]
script/source = "extends Control

# 测试场景只负责展示基础卡牌 UI，不包含战斗、抽牌、敌人或地图逻辑。
const TEST_CARDS := [
	{
		\"id\": \"strike\",
		\"name\": \"打击\",
		\"cost\": 1,
		\"type\": \"Attack\",
		\"rarity\": \"Common\",
		\"description\": \"造成 6 点伤害。\",
		\"art_path\": \"res://art/cards/basic_attack_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"defend\",
		\"name\": \"防御\",
		\"cost\": 1,
		\"type\": \"Skill\",
		\"rarity\": \"Common\",
		\"description\": \"获得 5 点格挡。\",
		\"art_path\": \"res://art/cards/basic_defend_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"bash\",
		\"name\": \"重击\",
		\"cost\": 2,
		\"type\": \"Attack\",
		\"rarity\": \"Common\",
		\"description\": \"造成 8 点伤害。\",
		\"art_path\": \"res://art/cards/bash_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"demon_form\",
		\"name\": \"恶魔形态\",
		\"cost\": 3,
		\"type\": \"Power\",
		\"rarity\": \"Rare\",
		\"description\": \"在你的回合开始时，获得 2 点力量。\",
		\"art_path\": \"res://art/cards/demon_form_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"spot_weakness\",
		\"name\": \"观察弱点\",
		\"cost\": 1,
		\"type\": \"Skill\",
		\"rarity\": \"Uncommon\",
		\"description\": \"如果目标意图为攻击，获得 3 点力量。\",
		\"art_path\": \"res://art/cards/spot_weakness_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"limit_break\",
		\"name\": \"突破极限\",
		\"cost\": 1,
		\"type\": \"Skill\",
		\"rarity\": \"Rare\",
		\"description\": \"使你的力量翻倍。消耗。\",
		\"art_path\": \"res://art/cards/limit_break_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"double_tap\",
		\"name\": \"双发\",
		\"cost\": 1,
		\"type\": \"Skill\",
		\"rarity\": \"Rare\",
		\"description\": \"本回合你的下一张攻击牌打出两次。\",
		\"art_path\": \"res://art/cards/double_tap_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"body_slam\",
		\"name\": \"全身撞击\",
		\"cost\": 1,
		\"type\": \"Attack\",
		\"rarity\": \"Common\",
		\"description\": \"造成等同于当前格挡的伤害。\",
		\"art_path\": \"res://art/cards/body_slam_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"barricade\",
		\"name\": \"壁垒\",
		\"cost\": 3,
		\"type\": \"Power\",
		\"rarity\": \"Rare\",
		\"description\": \"你的格挡在回合开始时不再消失。\",
		\"art_path\": \"res://art/cards/barricade_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"feel_no_pain\",
		\"name\": \"无惧疼痛\",
		\"cost\": 1,
		\"type\": \"Power\",
		\"rarity\": \"Uncommon\",
		\"description\": \"每当有一张牌被消耗时，获得 3 点格挡。\",
		\"art_path\": \"res://art/cards/feel_no_pain_art.png\",
		\"frame_path\": \"\"
	},
	{
		\"id\": \"rage\",
		\"name\": \"盛怒\",
		\"cost\": 0,
		\"type\": \"Skill\",
		\"rarity\": \"Uncommon\",
		\"description\": \"本回合每当你打出一张攻击牌，获得 3 点格挡。\",
		\"art_path\": \"res://art/cards/rage_art.png\",
		\"frame_path\": \"\"
	}
]


func _ready() -> void:
	# 场景加载完成后把测试卡牌交给 HandArea 展示。
	$HandArea.set_cards(TEST_CARDS)
"

[node name="CardUiTestScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_card_test")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.065, 0.075, 1)

[node name="HandArea" parent="." instance=ExtResource("1_hand_area_scene")]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
